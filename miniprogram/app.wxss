page {
  min-height: 100%;
  background: #f4f6f7;
  color: #1f2933;
  font-size: 28rpx;
}

.page {
  box-sizing: border-box;
  padding: 28rpx;
}

.section {
  margin-bottom: 24rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #d8e0e5;
  border-radius: 12rpx;
  padding: 24rpx;
}

.title {
  color: #004165;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.muted {
  color: #667085;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.button-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

button {
  border-radius: 10rpx;
  font-weight: 600;
  letter-spacing: 0;
}

button::after {
  border: 0;
}

button[type='primary'] {
  color: #ffffff;
  background: #004165;
}

button[type='warn'] {
  color: #b42318;
  border: 1rpx solid #e7b7b2;
  background: #ffffff;
}

button[disabled],
button[type='primary'][disabled] {
  color: #ffffff;
  background: #a9b2b1;
  opacity: 0.72;
}

input,
textarea {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid #c6d0d6;
  border-radius: 10rpx;
  padding: 14rpx;
  min-height: 72rpx;
}

textarea {
  min-height: 280rpx;
}

.button-icon {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
  margin-right: 12rpx;
}

.button-icon.small {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-rule {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #f2df74;
}

.brand-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  color: #772432;
  background: #f7edf0;
  font-size: 22rpx;
  font-weight: 600;
}
