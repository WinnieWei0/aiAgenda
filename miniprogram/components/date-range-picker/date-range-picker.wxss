.range-mask{position:fixed;inset:0;z-index:500;display:flex;align-items:center;justify-content:center;padding:28rpx;background:rgba(0,0,0,.48)}
.range-dialog{box-sizing:border-box;width:100%;max-width:680rpx;padding:28rpx;border-top:6rpx solid #772432;background:#fff;border-radius:12rpx}
.range-title{margin-bottom:22rpx;color:#004165;font-size:32rpx;font-weight:700;text-align:center}
.month-nav{display:flex;justify-content:center;gap:48rpx;margin-bottom:20rpx}.month-nav view{padding:12rpx 24rpx;border:1rpx solid #c6d0d6;border-radius:8rpx;color:#004165}
.week-row,.days-grid{display:grid;grid-template-columns:repeat(7,1fr)}.week-row text{padding:10rpx 0;color:#667085;font-size:24rpx;text-align:center}
.day{display:flex;align-items:center;justify-content:center;height:68rpx;font-size:26rpx}.day.in-range{background:#faf5d8}.day.selected{border-radius:50%;background:#004165;color:#fff}.day.empty{background:transparent}
.range-value{margin:20rpx 0;padding:16rpx;background:#f5f7f8;color:#475467;text-align:center}
.range-actions{display:flex;gap:12rpx}.range-actions button{flex:1;margin:0;font-size:26rpx}
