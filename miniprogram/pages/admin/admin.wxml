<view class="page">
  <view class="section panel">
    <view class="title">管理导航</view>
    <view class="muted">请选择要维护的数据表。</view>
  </view>

  <view class="section panel">
    <view class="nav-grid">
      <button class="nav-button" bindtap="openMembersList"><image class="nav-icon" src="/images/icons/users.png" mode="aspectFit" /><text>会员列表</text></button>
      <button class="nav-button" bindtap="openPathwaysList"><image class="nav-icon" src="/images/icons/route.png" mode="aspectFit" /><text>路径列表</text></button>
      <button class="nav-button" bindtap="openRolesList"><image class="nav-icon" src="/images/icons/shield.png" mode="aspectFit" /><text>角色列表</text></button>
    </view>
  </view>
</view>
