.editor-page { padding-bottom: 160rpx; }
.panel { margin-bottom: 20rpx; padding: 24rpx; border: 1rpx solid #d8e0e5; border-radius: 12rpx; background: #ffffff; }
.panel-title { display: block; margin-bottom: 20rpx; color:#004165; font-size: 32rpx; font-weight: 700; }
.basic-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.basic-info-grid .full { grid-column: 1 / -1; }
.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.field { display: block; min-width: 0; }
.field.full { grid-column: 1 / -1; }
.field text { display: block; margin-bottom: 8rpx; color: #475467; font-size: 24rpx; }
.field input, .field textarea, .picker-value { box-sizing: border-box; width: 100%; min-height: 72rpx; padding: 14rpx 18rpx; border: 1rpx solid #c6d0d6; border-radius:10rpx; background: #ffffff; }
.field input[disabled], .field textarea[disabled] { color: #475467; background: #f0f3f5; }
.field textarea { min-height: 120rpx; }
.field.compact { max-width: 260rpx; }
.time-warning { margin-top: 18rpx; padding: 14rpx; background: #fff7ed; color: #9a3412; font-size: 24rpx; }
.section-heading { display: flex; align-items: center; justify-content: space-between; margin: -24rpx -24rpx 18rpx; padding: 18rpx 24rpx; border-bottom: 1rpx solid #b5ccd7; border-left:6rpx solid #004165; border-radius:12rpx 12rpx 0 0; background: #e7f0f4; }
.section-time { display: inline-block; width: 96rpx; font-weight: 700; }
.section-title { font-size: 30rpx; font-weight: 700; }
.section-duration { color: #772432; font-weight: 700; }
.end-section { padding-bottom: 0; }
.end-section .section-heading { margin-bottom: 0; }
.agenda-row { padding: 18rpx 0; border-bottom: 1rpx solid #e2e8f0; }
.agenda-row:last-child { border-bottom: 0; }
.row-main { display: flex; align-items: center; gap: 10rpx; }
.role-title-label { flex: 1; min-width: 0; color: #334155; font-size: 28rpx; line-height: 1.4; word-break: break-word; }
.single-row > .field { display: flex; align-items: center; gap: 12rpx; }
.single-row > .field text { flex: 0 0 auto; margin: 0; }
.single-row > .field input { flex: 1; min-width: 0; }
.duration-input { width: 110rpx; height: 64rpx; padding: 0 10rpx; border: 1rpx solid #c6d0d6; border-radius:8rpx; text-align: right; }
.note-row { padding: 14rpx; background: #e5e7eb; font-style: italic; }
.person-editor { margin-top: 14rpx; }
.person-line { display: grid; grid-template-columns: 100rpx minmax(0, 1fr) 112rpx; gap: 10rpx; align-items: center; }
.person-label { color: #667085; font-size: 24rpx; }
.person-control, .club-input { box-sizing: border-box; width: 100%; min-width: 0; height: 64rpx; padding: 0 12rpx; border: 1rpx solid #c6d0d6; border-radius:8rpx; }
.member-picker { width: 100%; min-width: 0; height: 64rpx; padding: 0; overflow: hidden; border: 0; }
.selector-trigger { display:flex; align-items:center; justify-content:space-between; margin:0; color:#1f2933; font-size:28rpx; font-weight:400; line-height:1.2; text-align:left; }
.selector-trigger::after { border:0; }
.pathway-picker-trigger { display: flex; align-items: center; justify-content: space-between; margin: 0; text-align: left; }
.pathway-picker-trigger::after { border: 0; }
.person-control .picker-value { display: flex; box-sizing: border-box; min-height: 64rpx; align-items: center; justify-content: space-between; padding: 12rpx; border: 1rpx solid #c6d0d6; border-radius:8rpx; background: #ffffff; overflow: hidden; }
.picker-label { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.picker-arrow { flex: 0 0 auto; margin-left: 12rpx; color: #667085; font-size: 30rpx; line-height: 1; }
.switch-button { box-sizing: border-box; width: 112rpx; min-width: 112rpx; max-width: 112rpx; height: 64rpx; margin: 0; padding: 0 8rpx; font-size: 24rpx; line-height: 64rpx; white-space: nowrap; }
.club-line { display: grid; grid-template-columns: 100rpx minmax(0, 1fr); gap: 10rpx; align-items: center; margin-top: 10rpx; }
.club-label { color: #667085; font-size: 24rpx; }
.club-input[disabled] { color: #475467; background: #f0f3f5; }
.fixed-person, .derived-person, .fixed-club { margin-top: 12rpx; color: #475467; }
.member-status { display: block; margin-top: 4rpx; color: #667085; font-size: 22rpx; }
.member-status.error { color: #b42318; }
.prepared-block { margin: 30rpx 0; padding: 20rpx; border-left: 6rpx solid #772432; border-radius:8rpx; background: #f7f8f9; }
.block-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; font-weight: 700; }
.block-head button, .prepared-delete { margin-right: 0; margin-left: auto; }
.prepared-block > .field { display: grid; grid-template-columns: 170rpx minmax(0, 1fr); gap: 14rpx; align-items: center; margin-top: 14rpx; }
.prepared-block > .field text { margin: 0; }
.prepared-block > .field.compact { max-width: none; }
.objective { margin: 14rpx 0; padding: 16rpx; border-left:4rpx solid #f2df74; background: #f5f7f8; color: #344054; font-size: 24rpx; line-height: 1.55; }
.sort-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 16rpx; }
.sort-actions button { margin: 0; }
.module-controls { display: grid; grid-template-columns: 1fr auto; gap: 10rpx; align-items: center; margin-top: 18rpx; padding-top: 14rpx; border-top: 1rpx solid #e2e8f0; }
.module-actions { display: flex; gap: 10rpx; }
.module-actions button, .delete-module { margin: 0; }
.position-note { grid-column: 1 / -1; color: #667085; font-size: 22rpx; }
.dynamic-child-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10rpx; margin-top: 12rpx; }
.dynamic-child-meta button { margin: 0 0 0 auto; }
.dynamic-child-meta .position-note { width: 100%; }
.add-module-panel .panel-title { margin-bottom: 14rpx; }
.add-module-picker, .language-picker, .basic-picker { display: flex; box-sizing: border-box; width: 100%; min-height: 72rpx; align-items: center; justify-content: space-between; padding: 14rpx 18rpx; border: 1rpx solid #c6d0d6; border-radius:10rpx; background: #ffffff; }
.add-button { margin-top: 18rpx; border: 1rpx dashed #004165; color: #004165; background: #ffffff; }
.qr-panel { display: block; }
.qr-row { display: flex; align-items: center; justify-content: space-between; }
.qr-row .panel-title { margin: 0; }
.qr-row button { margin: 0; }
.qr-panel .reset-button { width: 100%; margin-top: 24rpx; }
.muted { display: block; margin-top: 6rpx; color: #667085; font-size: 24rpx; }
.bottom-actions { position: fixed; right: 0; bottom: 0; left: 0; z-index: 10; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #d8e0e5; background: #ffffff; box-shadow:0 -6rpx 18rpx rgba(0,65,101,.06); }
.bottom-actions button { box-sizing: border-box; width: 100%; min-width: 0; margin: 0; white-space: nowrap; }
.preview-button { overflow: hidden; color: #ffffff; background: #772432; text-overflow: clip; }
.signup-entry, .save-agenda-button { background: #004165; color: #ffffff; }
.signup-summary { margin: 16rpx 0; color: #772432; font-weight: 600; }
.signup-slot { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; border-bottom: 1rpx solid #e5e7eb; }
.slot-person { flex: 1; color: #6b7280; text-align: right; }
.signup-slot button { margin: 0; }
.reset-button { color: #b42318 !important; border: 1rpx solid #e7b7b2 !important; background: #ffffff !important; }
.validation-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 28rpx; background: rgba(0, 0, 0, 0.55); }
.validation-dialog { box-sizing: border-box; width: 100%; max-width: 680rpx; overflow: hidden; border-radius: 8rpx; background: #ffffff; }
.validation-title { display: block; padding: 34rpx 32rpx 22rpx; color: #004165; font-size: 34rpx; font-weight: 700; text-align: center; }
.validation-list { box-sizing: border-box; max-height: 480rpx; padding: 6rpx 40rpx 28rpx; }
.validation-error { display: block; margin-top: 12rpx; color: #667085; font-size: 28rpx; line-height: 1.5; word-break: break-all; }
.validation-more { color: #9a3412; }
.validation-confirm { width: 100%; margin: 0; border-top: 1rpx solid #d8e0e5; border-radius: 0; color: #004165; background: #ffffff; font-weight: 700; }
.validation-confirm::after { border: 0; }
@media (max-width: 420px) { .field-grid { grid-template-columns: 1fr; } .field.full { grid-column: auto; } .person-line { grid-template-columns: 84rpx minmax(0, 1fr) 112rpx; gap: 8rpx; } .person-label { font-size: 22rpx; } .club-line { grid-template-columns: 84rpx minmax(0, 1fr); gap: 8rpx; } .club-label { font-size: 22rpx; } .bottom-actions { gap: 12rpx; padding-right: 18rpx; padding-left: 18rpx; } .preview-button { padding-right: 8rpx; padding-left: 8rpx; } }
