<view class="page home-page">
  <button class="home-button primary-button" bindtap="openParseTab">解析议程表</button>
  <button class="home-button secondary-button" bindtap="openTimer">时间牌</button>
  <button wx:if="{{isAdmin}}" class="home-button secondary-button" bindtap="openMembersList">会员列表</button>
  <button wx:if="{{isAdmin}}" class="home-button secondary-button" bindtap="openPathwaysList">路径列表</button>
  <button wx:if="{{isAdmin}}" class="home-button invite-button" bindtap="openMembershipInvite">邀请绑定</button>
  <button wx:if="{{isAdmin}}" class="home-button template-button" bindtap="openTemplateEditor">编辑议程模板</button>
</view>
