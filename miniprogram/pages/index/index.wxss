.home-page {
  padding-top: 28rpx;
}

.brand-hero {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 28rpx;
  border-radius: 12rpx;
  background: #004165;
  box-shadow: 0 8rpx 24rpx rgba(0, 65, 101, 0.14);
}

.club-logo {
  width: 116rpx;
  height: 112rpx;
  flex: 0 0 auto;
  border-radius: 8rpx;
  background: #ffffff;
}

.brand-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
}

.club-title {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.club-title-en {
  margin-top: 4rpx;
  color: #d8e8ef;
  font-size: 21rpx;
  line-height: 1.35;
}

.brand-copy .brand-rule {
  margin: 16rpx 0 12rpx;
}

.welcome-text {
  color: #ffffff;
  font-size: 26rpx;
}

.section-heading {
  margin: 34rpx 0 16rpx;
  color: #004165;
  font-size: 30rpx;
  font-weight: 700;
}

.home-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.home-action {
  display: flex;
  box-sizing: border-box;
  min-width: 0;
  min-height: 190rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 22rpx 14rpx;
  border: 1rpx solid #d8e0e5;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 5rpx 16rpx rgba(0, 65, 101, 0.06);
  text-align: center;
  line-height: 1.2;
}

.home-action[disabled] {
  color: #667085;
  background: #eef1f3;
  opacity: 0.68;
}

.home-action[disabled] .action-title,
.home-action[disabled] .action-meta {
  color: #667085;
}

.action-icon {
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 14rpx;
}

.action-title {
  color: #1f2933;
  font-size: 29rpx;
  font-weight: 700;
}

.action-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
  font-weight: 400;
}

.invite-action {
  border-color: #772432;
  background: #772432;
}

.invite-action .action-title,
.invite-action .action-meta {
  color: #ffffff;
}

.invite-action .action-meta {
  opacity: 0.78;
}

.guest-welcome {
  display: flex;
  min-height: 38vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  text-align: center;
}

.guest-kicker {
  color: #772432;
  font-size: 22rpx;
  font-weight: 700;
}

.guest-title {
  margin-top: 14rpx;
  color: #004165;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
}

.guest-rule {
  width: 48rpx;
  height: 4rpx;
  margin-top: 22rpx;
  background: #f2df74;
}
