.home-page {
  padding-top: 36rpx;
}

.home-button {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  margin: 0 0 24rpx;
  padding: 0;
  border-radius: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
}

.secondary-button {
  color: #111827;
  background: #f3f4f6;
  border: 1rpx solid #cbd5e1;
}

.invite-button { color: #ffffff; background: #0f766e; }

.welcome-copy {
  display: flex;
  min-height: 55vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  text-align: center;
}

.club-title {
  color: #0f766e;
  font-size: 38rpx;
  font-weight: 700;
}

.welcome-text {
  color: #374151;
  font-size: 30rpx;
}
