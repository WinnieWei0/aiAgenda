.form-panel input,
.form-panel textarea {
  margin-top: 8rpx;
}

.form-row,
.switch-row,
.readonly-field {
  margin-bottom: 18rpx;
}

.form-row text,
.switch-row text,
.readonly-field text:first-child {
  display: block;
  margin-bottom: 6rpx;
  color: #475467;
  font-size: 24rpx;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.switch-row text {
  margin: 0;
}

.readonly-field text:last-child {
  display: block;
  min-height: 42rpx;
  padding: 12rpx;
  box-sizing: border-box;
  color: #667085;
  background: #f5f7f8;
  border-radius: 6rpx;
  word-break: break-all;
}

.form-actions {
  margin-top: 28rpx;
  flex-wrap: nowrap;
}

.form-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
}

.form-panel .notes-input { height:112rpx; min-height:112rpx; line-height:36rpx; }

.role-picker { box-sizing:border-box; min-height:72rpx; padding:16rpx; border:1rpx solid #c6d0d6; border-radius:10rpx; background:#fff; }
.clear-binding { margin:0 0 22rpx; color:#b42318; border:1rpx solid #e7b7b2; background:#fff; }

.privacy-panel {
  margin: 20rpx 0 24rpx;
  padding: 22rpx;
  border: 1rpx solid #c9d9e1;
  border-left: 6rpx solid #004165;
  border-radius: 10rpx;
  background: #f6f9fa;
}

.privacy-title { display:block; color:#004165; font-size:28rpx; font-weight:700; }
.privacy-description { display:block; margin-top:10rpx; color:#475467; font-size:24rpx; line-height:1.65; }
.legal-links { display:flex; flex-wrap:wrap; gap:8rpx 18rpx; margin-top:12rpx; }
.text-link { width:auto; min-height:44rpx; margin:0; padding:0; color:#772432; background:transparent; font-size:24rpx; line-height:44rpx; }
.text-link::after { border:0; }
.privacy-agree-button { margin:18rpx 0 0; color:#fff; background:#004165; font-size:26rpx; }
.privacy-status { margin-top:16rpx; color:#168a68; font-size:24rpx; font-weight:600; }
.authorization-check { display:flex; align-items:flex-start; gap:10rpx; margin-top:18rpx; color:#344054; font-size:24rpx; line-height:1.55; }
.authorization-check checkbox { flex:none; }
.authorization-check.disabled { color:#98a2b3; }
.form-panel input[disabled] { color:#98a2b3; background:#eef1f3; }

.consent-section { margin-top:28rpx; padding:20rpx; border-top:1rpx solid #d8e0e5; background:#f8fafb; }
.consent-links { display:flex; flex-wrap:wrap; align-items:center; gap:4rpx; color:#667085; font-size:23rpx; line-height:1.6; }
.consent-links .text-link { display:inline; min-height:0; margin:0; padding:0; color:#772432; background:transparent; font-size:23rpx; line-height:1.6; }
.consent-links .text-link::after { border:0; }
.consent-section .authorization-check { display:flex; align-items:flex-start; gap:10rpx; margin-top:14rpx; color:#344054; font-size:24rpx; line-height:1.55; }
.consent-section .authorization-check checkbox { flex:none; }
.consent-section .authorization-check .text-link { display:inline; min-height:0; margin:0; padding:0; color:#772432; background:transparent; font-size:24rpx; line-height:1.55; }
.consent-section .authorization-check .text-link::after { border:0; }
.consent-section .terms-check { width:100%; box-sizing:border-box; flex-wrap:nowrap; align-items:flex-start; gap:10rpx; overflow:visible; white-space:normal; font-size:24rpx; line-height:1.55; }
.consent-section .terms-check > checkbox { flex:none; margin-top:4rpx; }
.consent-section .terms-copy { min-width:0; flex:1; display:flex; flex-wrap:wrap; align-items:flex-start; gap:0; overflow:hidden; font-size:24rpx; line-height:1.55; }
.consent-section .terms-copy > text,
.consent-section .terms-copy .text-link { flex:none; }
.consent-section .terms-copy .text-link { width:auto; min-width:0; overflow:visible; margin:0; padding:0; font-size:24rpx; line-height:1.55; }
.form-actions .save-button,
.form-actions .button-hover { color:#fff; background:#004165; }
