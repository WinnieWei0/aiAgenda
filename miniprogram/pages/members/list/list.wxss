.actions {
  margin-top: 16rpx;
}

.record-card {
  background: #ffffff;
  border: 1rpx solid #dde3ea;
  border-radius: 8rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
}

.record-title {
  font-weight: 700;
  min-width: 0;
  overflow-wrap: anywhere;
}

.member-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.officer-title {
  flex-shrink: 0;
  color: #475569;
  font-size: 24rpx;
  text-align: right;
}

.card-actions {
  margin-top: 14rpx;
}
