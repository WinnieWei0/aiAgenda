<view class="page invite-page"><view wx:if="{{loading}}" class="panel">加载中...</view><view wx:elif="{{token && invite}}" class="panel confirm-panel"><text class="title">确认绑定身份</text><text class="member-name">{{invite.member.nameZh || invite.member.nameEn}}</text><text class="member-meta">{{invite.member.nameEn}} · {{invite.member.role === 'super_admin' ? '超管' : (invite.member.role === 'admin' ? '管理员' : '会员')}}</text><button type="primary" loading="{{claiming}}" bindtap="claimInvite">确认绑定</button></view><block wx:elif="{{!token}}"><view class="panel"><text class="title">创建会员邀请</text><button class="member-trigger" bindtap="openSelector">{{selectedMember ? (selectedMember.nameZh || selectedMember.nameEn) : '选择未绑定会员'}}</button><button type="primary" disabled="{{!selectedMember}}" loading="{{creating}}" bindtap="createInvite">生成邀请</button><button wx:if="{{createdInvite}}" class="share-button" open-type="share">分享给会员</button><text wx:if="{{createdInvite}}" class="expiry">邀请将在 24 小时后失效，且只能使用一次。</text></view></block></view>
<member-selector visible="{{selectorVisible}}" members="{{members}}" selected-id="{{selectedMember._id}}" title="选择未绑定会员" bindcancel="closeSelector" bindconfirm="confirmSelector" />
