.invite-page{padding-top:32rpx}.panel{padding:30rpx;border:1rpx solid #d8e0e5;border-top:6rpx solid #772432;border-radius:12rpx;background:#fff;box-shadow:0 6rpx 20rpx rgba(0,65,101,.06)}.title{display:block;margin-bottom:28rpx;color:#004165;font-size:34rpx;font-weight:700}.member-trigger{box-sizing:border-box;width:100%;margin:0 0 22rpx;border:1rpx solid #c6d0d6;border-radius:10rpx;background:#fff;color:#344054;text-align:left}.confirm-panel{text-align:center}.member-name{display:block;margin:32rpx 0 10rpx;color:#004165;font-size:42rpx;font-weight:700}.member-meta{display:block;margin-bottom:36rpx;color:#667085}.share-button{margin-top:20rpx;color:#fff;background:#772432}.expiry{display:block;margin-top:18rpx;color:#667085;font-size:24rpx;text-align:center}
