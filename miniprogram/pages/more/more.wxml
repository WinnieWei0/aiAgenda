<view class="more-page">
  <view class="section-title">默认俱乐部</view>
  <picker wx:if="{{clubs.length}}" class="club-picker" mode="selector" range="{{clubs}}" range-key="displayName" value="{{clubIndex}}" bindchange="chooseDefaultClub">
    <view class="selector active picker-value">
      <text>{{clubs[clubIndex].displayName}}</text>
      <text class="picker-arrow">▾</text>
    </view>
  </picker>
  <view wx:else class="empty">俱乐部列表暂时无法加载</view>
  <text class="hint">下次进入首页时将自动选中该俱乐部</text>
</view>
