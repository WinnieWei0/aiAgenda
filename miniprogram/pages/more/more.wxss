.more-page { padding: 32rpx 28rpx; }
.section-title { display: block; margin: 22rpx 0 12rpx; color: #004165; font-size: 28rpx; font-weight: 700; }
.info-panel { box-sizing: border-box; padding: 28rpx 24rpx; border: 1rpx solid #d8e0e5; border-radius: 6rpx; background: #fff; }
.intro-title { display: block; color: #004165; font-size: 34rpx; font-weight: 700; }
.intro-text { display: block; margin-top: 16rpx; color: #475467; font-size: 27rpx; line-height: 1.7; }
.contact-panel { display: flex; align-items: center; }
.contact-label { color: #667085; font-size: 27rpx; }
.contact-value { margin-left: 20rpx; color: #1f2933; font-size: 30rpx; font-weight: 700; }
.copy-button { margin-left: auto; padding: 0 20rpx; color: #004165; border: 1rpx solid #004165; background: #fff; font-size: 24rpx; line-height: 2.2; }
