.agenda-home {
  padding-top: 28rpx;
}

.agenda-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; margin-bottom:22rpx; padding:26rpx 24rpx; border-radius:12rpx; background:#004165; box-shadow:0 8rpx 24rpx rgba(0,65,101,.13); }
.heading-copy { display:flex; min-width:0; flex-direction:column; }
.heading-kicker { color:#f2df74; font-size:20rpx; font-weight:700; }
.heading-title { margin-top:6rpx; color:#fff; font-size:36rpx; font-weight:700; }
.identity-chip { display:flex; max-width:48%; flex-direction:column; align-items:flex-end; padding-left:18rpx; border-left:1rpx solid rgba(255,255,255,.28); text-align:right; }
.identity-label { color:#bcd1dc; font-size:21rpx; }
.identity-value { max-width:100%; margin-top:5rpx; overflow:hidden; color:#fff; font-size:26rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }

.summary {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  min-height: 170rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 28rpx;
  background: #fff;
  border: 1rpx solid #d8e0e5;
  border-top: 6rpx solid #772432;
  border-radius: 12rpx;
  color: #475467;
  box-shadow: 0 5rpx 18rpx rgba(0, 65, 101, 0.05);
}

.summary.empty {
  color: #6b7280;
}

.summary-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #004165;
}

.summary-meta {
  font-size: 28rpx;
}

.summary-kicker { color:#772432; font-size:22rpx; font-weight:700; }
.agenda-actions { display:flex; flex-direction:column; gap:18rpx; }

.action-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 20rpx 28rpx;
  border: 1rpx solid #c6d0d6;
  border-radius: 10rpx;
  background: #fff;
  color: #1f2937;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 54rpx;
}

.action-button::after {
  border: 0;
}

.action-button.primary {
  color: #fff;
  background: #004165;
  border-color: #004165;
}

.action-button.template-button {
  color: #772432;
  background: #ffffff;
  border-color: #772432;
}

.action-button.secondary { color:#004165; background:#fff; border-color:#8aa8b8; }
