.agenda-home { padding-top: 32rpx; }
.summary { display:flex; flex-direction:column; gap:12rpx; padding:28rpx; margin-bottom:28rpx; background:#fff; border:1rpx solid #d1d5db; border-radius:8rpx; color:#4b5563; }
.summary.empty { color:#6b7280; }
.summary-title { font-size:36rpx; font-weight:700; color:#111827; }
button { margin-top:20rpx; border-radius:8rpx; background:#fff; border:1rpx solid #cbd5e1; }
button.primary { color:#fff; background:#0f766e; border-color:#0f766e; }
