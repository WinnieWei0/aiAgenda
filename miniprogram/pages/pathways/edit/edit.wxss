.form-panel input,
.form-panel textarea {
  margin-top: 8rpx;
}

.form-panel textarea {
  height: 112rpx;
  min-height: 112rpx;
  line-height: 36rpx;
}

.form-row,
.readonly-field {
  margin-bottom: 18rpx;
}

.form-row text,
.readonly-field text:first-child {
  display: block;
  margin-bottom: 6rpx;
  color: #475467;
  font-size: 24rpx;
}

.readonly-field text:last-child {
  display: block;
  min-height: 42rpx;
  padding: 12rpx;
  box-sizing: border-box;
  color: #667085;
  background: #f5f7f8;
  border-radius: 6rpx;
  word-break: break-all;
}

.form-actions {
  margin-top: 28rpx;
  flex-wrap: nowrap;
}

.form-actions button {
  flex: 1;
  min-width: 0;
  margin: 0;
}
