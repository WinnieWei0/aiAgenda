.actions {
  margin-top: 16rpx;
}

.record-card {
  background: #ffffff;
  border: 1rpx solid #d8e0e5;
  border-left: 5rpx solid #004165;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.record-title {
  color: #004165;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-actions {
  margin-top: 14rpx;
}

.card-actions button {
  min-height: 48rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
  line-height: 48rpx;
}

.card-actions .button-icon.small {
  width: 24rpx;
  height: 24rpx;
  margin-right: 5rpx;
}
