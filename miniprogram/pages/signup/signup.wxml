<view wx:if="{{loading && !data}}" class="page-loading"><view class="loading-card"><text class="loading-title">角色报名</text><text class="loading-text">正在加载会议信息...</text></view></view>
<view wx:if="{{!loading && !data}}" class="page-loading"><view class="loading-card"><text class="loading-title">角色报名</text><text class="loading-text">{{loadError || '当前会议尚未开放报名'}}</text></view></view>
<view class="signup-page" wx:if="{{data}}">
  <view class="meeting-hero">
    <image class="hero-logo" src="/images/template/toastmasters-logo.png" mode="aspectFit" />
    <view class="hero-copy">
      <text class="club-name">{{data.language === 'en' ? data.club.nameEn : data.club.nameZh}}</text>
      <view class="hero-rule"></view>
      <text class="meeting-name">{{data.language === 'en' ? 'Meeting No. ' : '第'}}{{data.meetingInfo.meetingNo || '--'}}{{data.language === 'en' ? '' : '次会议'}}</text>
    </view>
  </view>

  <view class="card meeting-card">
    <text class="card-title">{{data.language === 'en' ? 'Meeting Information' : '会议信息'}}</text>
    <view class="info-row"><text class="info-label">{{data.language === 'en' ? 'Date' : '日期'}}</text><text class="info-value">{{data.meetingInfo.date || (data.language === 'en' ? 'To be filled' : '待填写')}}{{data.signupDisplay.weekdayLabel ? ' ' + data.signupDisplay.weekdayLabel : ''}}</text></view>
    <view class="info-row"><text class="info-label">{{data.language === 'en' ? 'Time' : '时间'}}</text><text class="info-value">{{data.meetingInfo.startTime}}~{{data.meetingInfo.endTime}}</text></view>
    <view class="info-row"><text class="info-label">{{data.language === 'en' ? 'Venue' : '地点'}}</text><text class="info-value">{{data.templateVenue || (data.language === 'en' ? 'To be filled' : '待填写')}}{{data.signupDisplay.venueSuffix ? ' ' + data.signupDisplay.venueSuffix : ''}}</text></view>
    <view class="info-row"><text class="info-label">{{data.language === 'en' ? 'Guest fee' : '费用'}}</text><text class="info-value">{{data.signupDisplay.guestFee}}</text></view>
    <view class="info-row"><text class="info-label">MM</text><text class="info-value">{{data.meetingManagerName}}</text></view>
  </view>

  <view class="metrics">
    <view class="metric"><text class="number">{{data.remainingRoles}}</text><text class="metric-label">{{data.language === 'en' ? 'Roles Available' : '剩余角色'}}</text></view>
    <view class="metric"><text class="number">{{data.attendeeCount}}</text><text class="metric-label">{{data.language === 'en' ? 'Attendees' : '参会人数'}}</text></view>
  </view>

  <view class="card roles-card">
    <view class="card-heading"><text class="card-title">{{data.language === 'en' ? 'Role Sign-up' : '角色报名'}}</text><button class="attend-button" size="mini" data-slot-id="" bindtap="openSignup">{{data.language === 'en' ? 'Attend Only' : '仅参会'}}</button></view>
    <block wx:for="{{data.slotGroups}}" wx:for-item="group" wx:key="id">
      <view class="role-group {{group.grouped ? 'grouped' : 'single'}}">
        <view wx:if="{{group.grouped}}" class="role-group-title">{{group.title}}</view>
        <block wx:for="{{group.slots}}" wx:for-item="slot" wx:key="id">
          <view class="role-row {{slot.occupied ? 'claimed' : ''}}">
            <view class="role-copy"><view class="role-name-line"><text class="status-dot"></text><text class="role-name">{{slot.displayLabel || slot.label}}</text><text class="access-tag {{slot.isGuestRole ? 'guest-access-tag' : 'member-access-tag'}}">{{slot.isGuestRole ? 'Guest' : (data.language === 'en' ? 'Member' : '会员')}}</text></view></view>
            <button wx:if="{{!slot.occupied}}" class="claim-button" size="mini" data-slot-id="{{slot.id}}" bindtap="openSignup">{{data.language === 'en' ? 'Sign up' : '报名'}}</button>
            <view wx:elif="{{slot.canCancel||data.isAdmin}}" class="claimed-actions"><text class="claimed-name">{{data.language === 'en' ? (slot.person.displayNameEn || slot.person.rawName) : (slot.person.displayNameZh || slot.person.rawName)}}</text><button class="x-button" size="mini" data-id="{{slot.signupId}}" bindtap="cancelSignup">X</button></view>
            <text wx:else class="claimed-name">{{data.language === 'en' ? (slot.person.displayNameEn || slot.person.rawName) : (slot.person.displayNameZh || slot.person.rawName)}}</text>
          </view>
        </block>
      </view>
    </block>
  </view>

  <view class="card people-card">
    <text class="card-title">{{data.language === 'en' ? 'Signed-up People' : '已报名人员'}}</text>
    <view wx:if="{{!data.people.length}}" class="empty">{{data.language === 'en' ? 'No sign-ups yet' : '暂无报名'}}</view>
    <view wx:for="{{data.people}}" wx:key="key" class="person">
      <view class="person-identity"><text class="person-name">{{item.name}}</text><text wx:if="{{item.personType === 'club' && item.club}}" class="club-tag">{{item.club}}</text><text wx:if="{{item.personType === 'guest'}}" class="club-tag">{{data.language === 'en' ? 'Guest' : '宾客'}}</text><text wx:if="{{item.personType === 'preset' && item.club}}" class="club-tag">{{item.club}}</text></view>
      <text wx:if="{{item.roles.length}}" class="person-role-labels role-label">{{item.rolesText}}</text>
      <button wx:elif="{{item.attendanceOnly && item.mine}}" class="x-button" size="mini" data-id="{{item.attendanceSignupId}}" bindtap="cancelSignup">X</button>
      <text wx:else class="attendance-label"></text>
    </view>
  </view>
</view>

<role-signup-modal visible="{{modal}}" role-slot="{{selectedSlot}}" members="{{members}}" language="{{data.language}}" submitting="{{submitting}}" bindcancel="closeModal" bindconfirm="submitSignup" />
