.signup-page{padding-bottom:40rpx}.section{background:#fff;border-top:1rpx solid #e5e7eb;border-bottom:1rpx solid #e5e7eb;margin:20rpx -24rpx 0;padding:24rpx}.title{display:block;font-size:32rpx;font-weight:700;margin-bottom:20rpx}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;color:#374151}.wide{grid-column:1/-1}.metrics{display:flex;justify-content:space-around;text-align:center}.metrics view{display:flex;flex-direction:column;gap:4rpx}.number{font-size:48rpx;font-weight:700;color:#0f766e}.attend{background:#ecfdf5;color:#065f46;border:1rpx solid #6ee7b7}.roles{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:16rpx}.roles button,.occupied{min-height:82rpx;margin:0;border-radius:6rpx;font-size:28rpx}.occupied{display:flex;flex-direction:column;justify-content:center;padding:8rpx 16rpx;background:#f3f4f6;color:#6b7280}.person{padding:18rpx 0;border-bottom:1rpx solid #e5e7eb}.person-name{font-weight:700;margin-right:12rpx}.tag{font-size:22rpx;color:#0f766e;background:#ccfbf1;padding:4rpx 10rpx;border-radius:4rpx}.club{display:block;color:#6b7280;margin-top:6rpx}.person-roles{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}.role-chip{display:flex;align-items:center;gap:8rpx;background:#f3f4f6;padding:6rpx 10rpx;border-radius:4rpx}.role-chip button{margin:0;padding:0 12rpx;line-height:44rpx}.empty{color:#9ca3af}.mask{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;z-index:20}.modal{width:100%;background:#fff;padding:28rpx 24rpx 48rpx;box-sizing:border-box}.modal-title{display:block;font-size:34rpx;font-weight:700;margin-bottom:20rpx}.types{display:flex;gap:12rpx}.types button{flex:1;margin:0;font-size:26rpx}.types .active{color:#fff;background:#0f766e}.picker,input{box-sizing:border-box;width:100%;margin-top:18rpx;padding:20rpx;border:1rpx solid #cbd5e1;border-radius:6rpx}.submit{margin-top:24rpx;background:#0f766e;color:#fff}
